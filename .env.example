# Google OAuth + Sheets (no service account needed)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_SHEETS_ID=

# Single-user access control
ALLOWED_EMAIL=your@gmail.com

# NextAuth — generate with: npx auth secret
AUTH_SECRET=

# API keys (at least one provider is required)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
