# Google OAuth + Sheets (no service account needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_ID=GOOGLE_SHEETS_ID_REDACTED

# Single-user access control
ALLOWED_EMAIL=your@gmail.com

# NextAuth — generate with: npx auth secret
AUTH_SECRET=

# AI provider
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5

# API keys (only the active provider is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
